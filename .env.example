# Runtime
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/salonbook

# Deployment URLs
# SERVER_URL is this API's public URL.
SERVER_URL=http://localhost:5000
# CLIENT_URL is the frontend public URL.
CLIENT_URL=http://localhost:3000
# BETTER_AUTH_URL is the public auth base URL. Auth requests are proxied
# through the frontend at /api/auth, so this matches CLIENT_URL.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_BASE_URL=http://localhost:3000
# Optional override. Defaults to ${SERVER_URL}/api/auth/jwks
AUTH_JWKS_URL=http://localhost:5000/api/auth/jwks

# Comma-separated extra origins allowed by CORS (optional)
ALLOWED_ORIGINS=

# Better Auth
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe (test mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# ImgBB
IMGBB_API_KEY=

# Admin bootstrap / seed
# ADMIN_EMAIL can restrict admin bootstrap to a single address.
ADMIN_EMAIL=admin@salonbook.com
# Optional credentials for `npm run seed:admin` (or use SEED_ADMIN_* variants).
# If omitted, the script prompts interactively in a terminal.
ADMIN_NAME=SalonBook Admin
ADMIN_PASSWORD=
# Long random value required by the compatibility POST /api/admin/setup endpoint.
# Leave blank to disable that endpoint.
ADMIN_SETUP_SECRET=
